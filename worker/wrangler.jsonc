{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The API only. The web app (https://usepoof.chat) is hosted separately and calls this origin;
  // ALLOWED_ORIGINS below is what it may call from (CORS, WebSocket Origin check).
  "routes": [{ "pattern": "api.usepoof.chat", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "MAILBOX", "class_name": "MailboxDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "MailboxDO"] }],

  // Super Quant-Room payments: pass keys, the payment ledger (price vs. what arrived) and spent
  // passes. Nothing in it links a payment to a quant-room. Schema: migrations/.
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "poof-ledger",
      "database_id": "f41ad1b5-cd04-460c-b2b7-7f7657b72498",
      "migrations_dir": "migrations",
    },
  ],

  // NOTE: limits are enforced per Cloudflare location (colo), not globally. `period` must be 10 or 60.
  "ratelimits": [
    { "name": "RL_CREATE_ROOM", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ROOM_READ", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WS_JOIN", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_HANDSHAKE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PAY", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
  ],

  "vars": {
    "ROOM_TTL_FREE_SECONDS": "600",
    "ROOM_MAX_PEERS_FREE": "2",
    // "1" = file transfer in free rooms. Local/e2e testing only, until super rooms exist.
    "ROOM_FILES_FREE": "0",
    // "1" = the AI model in free rooms. Local testing only (it needs VENICE_API_KEY in .dev.vars).
    "ROOM_AI_FREE": "0",
    "FILE_MAX_BYTES": "2097152",
    // Comma-separated Origins allowed to call the API from a browser. `pnpm dev` adds the local ones.
    "ALLOWED_ORIGINS": "https://usepoof.chat",
    "COMMIT_SHA": "dev",
    // Where Super Quant-Room payments go: USDC on Ethereum and Base, USDG on Robinhood Chain …
    "PAY_TREASURY": "0x68222E6dC73e161045233B2b76a47d98F84A7e8C",
    // … and USDC on Solana. Empty = Solana isn't offered.
    "PAY_TREASURY_SOLANA": "AGQzMmBEgxTeLonpt11isEu6KBDv4h3VbPofCEy4i8Et",
  },

  // Zero-log posture: no Workers logs, no traces.
  "observability": { "enabled": false },
}
