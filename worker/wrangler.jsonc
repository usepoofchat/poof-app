{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The API only. The web app (https://usepoof.chat) is hosted separately and calls this origin;
  // ALLOWED_ORIGINS below is what it may call from (CORS, WebSocket Origin check).
  "routes": [{ "pattern": "api.usepoof.chat", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "MAILBOX", "class_name": "MailboxDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "MailboxDO"] }],

  // NOTE: limits are enforced per Cloudflare location (colo), not globally. `period` must be 10 or 60.
  "ratelimits": [
    { "name": "RL_CREATE_ROOM", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ROOM_READ", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WS_JOIN", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_HANDSHAKE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
  ],

  "vars": {
    "ROOM_TTL_FREE_SECONDS": "600",
    "ROOM_MAX_PEERS_FREE": "2",
    // "1" = file transfer in free rooms. Local/e2e testing only, until super rooms exist.
    "ROOM_FILES_FREE": "0",
    "FILE_MAX_BYTES": "2097152",
    // Comma-separated Origins allowed to call the API from a browser. `pnpm dev` adds the local ones.
    "ALLOWED_ORIGINS": "https://usepoof.chat",
    "COMMIT_SHA": "dev",
  },

  // Zero-log posture: no Workers logs, no traces.
  "observability": { "enabled": false },

  // Version/preview URLs are not generated for Workers with Durable Objects, so we use a real
  // `staging` environment instead. Durable Object namespaces are scoped per Worker name, so staging
  // gets its own rooms and mailboxes. Non-inheritable keys are repeated.
  "env": {
    "staging": {
      "name": "poof-staging",
      // Reachable at poof-staging.<account subdomain>.workers.dev only.
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "MAILBOX", "class_name": "MailboxDO" },
        ],
      },
      "ratelimits": [
        {
          "name": "RL_CREATE_ROOM",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 },
        },
        { "name": "RL_ROOM_READ", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_WS_JOIN", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_HANDSHAKE", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
      ],
      "vars": {
        "ROOM_TTL_FREE_SECONDS": "600",
        "ROOM_MAX_PEERS_FREE": "2",
        "ROOM_FILES_FREE": "0",
        "FILE_MAX_BYTES": "2097152",
        // The site, plus a site served locally (npx serve . → :3000) talking to staging.
        "ALLOWED_ORIGINS": "https://usepoof.chat,http://localhost:3000",
        "COMMIT_SHA": "dev",
      },
      "observability": { "enabled": false },
    },
  },
}
